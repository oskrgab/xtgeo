# Single source of truth for the xtgeo WASM/Pyodide distribution.
#
# The wheel is ABI-locked to ONE Pyodide release: its Emscripten toolchain and
# its bundled numpy/scipy/pandas. Bumping PYODIDE_VERSION is a deliberate act --
# the other values below must move with it (see the Pyodide changelog).
#
# This file is shell-sourceable AND parsed by the Node smoke test, the
# Dockerfile build args (via the Makefile), and CI. Keep it KEY=VALUE only.

# The pinned Pyodide release. This is the value consumers must match in their
# browser/Node Pyodide runtime.
PYODIDE_VERSION=0.29.4

# Toolchain pinned by the Pyodide release above.
PYTHON_VERSION=3.13.2
EMSCRIPTEN_VERSION=4.0.9

# pyodide-build (the cross-compilation frontend) -- decoupled from the Pyodide
# version since 0.28; pin it for reproducibility.
PYODIDE_BUILD_VERSION=0.34.4
